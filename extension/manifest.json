{
  "manifest_version": 3,
  "name": "__MSG_extensionListingTitle__",
  "version": "0.2.0",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "permissions": [
    "bookmarks",
    "storage",
    "unlimitedStorage",
    "alarms",
    "activeTab"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "scripts": [
      "shared/constants.js",
      "shared/normalize.js",
      "shared/categorize.js",
      "shared/cleanup.js",
      "shared/backup.js",
      "shared/link-checker.js",
      "shared/report.js",
      "shared/trash.js",
      "shared/messaging.js",
      "shared/scan-controller.js",
      "background/service-worker.js"
    ]
  },
  "action": {
    "default_popup": "ui/popup.html",
    "default_title": "__MSG_extensionName__",
    "default_icon": {
      "16": "assets/salvage-chrome-icon-16.png",
      "32": "assets/salvage-chrome-icon-32.png"
    }
  },
  "icons": {
    "16": "assets/salvage-chrome-icon-16.png",
    "32": "assets/salvage-chrome-icon-32.png",
    "48": "assets/salvage-chrome-icon-48.png",
    "128": "assets/salvage-chrome-icon-128.png",
    "256": "assets/salvage-chrome-icon-256.png"
  }
}
